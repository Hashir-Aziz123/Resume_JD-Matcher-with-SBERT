\": \"\"\n          }\n        }\n      }\n    }\n  },\n  \"cells\": [\n    {\n      \"cell_type\": \"markdown\",\n      \"source\": [\n        \"## Downloading necessary libraries\"\n      ],\n      \"metadata\": {\n        \"id\": \"a3PEwdqW214X\"\n      }\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {\n        \"id\": \"0hCC-a642Xs4\"\n      },\n      \"outputs\": [],\n      \"source\": [\n        \"!pip install sentence-transformers pandas\"\n      ]\n    },\n    {\n      \"cell_type\": \"markdown\",\n      \"source\": [\n        \"## Training the Model\"\n      ],\n      \"metadata\": {\n        \"id\": \"qxnjfcAl29oR\"\n      }\n    },\n    {\n      \"cell_type\": \"code\",\n      \"source\": [\n        \"import pandas as pd\\n\",\n        \"import torch\\n\",\n        \"from torch.utils.data import DataLoader\\n\",\n        \"from sentence_transformers import SentenceTransformer, InputExample, losses, evaluation\\n\",\n        \"import math\\n\",\n        \"import logging\\n\",\n        \"\\n\",\n        \"logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(message)s')\\n\",\n        \"\\n\",\n        \"# In Colab, uploaded files go straight to the /content/ directory\\n\",\n        \"data_path = \\\"/content/training_pairs.csv\\\"\\n\",\n        \"model_save_path = \\\"/content/sbert_finetuned\\\"\\n\",\n        \"\\n\",\n        \"logging.info(\\\"Checking hardware...\\\")\\n\",\n        \"device = \\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\"\\n\",\n        \"logging.info(f\\\"Executing on: {device.upper()}\\\")\\n\",\n        \"if device == \\\"cpu\\\":\\n\",\n        \"    logging.warning(\\\"WARNING: You didn't select a T4 GPU in the runtime settings! Stop the cell and change it.\\\")\\n\",\n        \"\\n\",\n        \"logging.info(\\\"Loading dataset...\\\")\\n\",\n        \"df = pd.read_csv(data_path)\\n\",\n        \"\\n\",\n        \"logging.info(\\\"Downloading base all-MiniLM-L6-v2 model...\\\")\\n\",\n        \"model = SentenceTransformer('all-MiniLM-L6-v2', device=device)\\n\",\n        \"\\n\",\n        \"logging.info(\\\"Formatting tensor pairs...\\\")\\n\",\n        \"train_examples = []\\n\",\n        \"\\n\",\n        \"for _, row in df.iterrows():\\n\",\n        \"    resume_input = f\\\"SKILLS: {row['resume_skills']} | CONTEXT: {str(row['resume_text'])[:1000]}\\\"\\n\",\n        \"    jd_input = f\\\"SKILLS: {row['jd_skills']} | CONTEXT: {str(row['jd_text'])[:1000]}\\\"\\n\",\n        \"    label = float(row['label'])\\n\",\n        \"\\n\",\n        \"    train_examples.append(InputExample(texts=[resume_input, jd_input], label=label))\\n\",\n        \"\\n\",\n        \"# 90/10 Train/Validation Split\\n\",\n        \"split_idx = int(0.9 * len(train_examples))\\n\",\n        \"train_data = train_examples[:split_idx]\\n\",\n        \"val_data = train_examples[split_idx:]\\n\",\n        \"\\n\",\n        \"train_dataloader = DataLoader(train_data, shuffle=True, batch_size=16)\\n\",\n        \"train_loss = losses.CosineSimilarityLoss(model)\\n\",\n        \"\\n\",\n        \"sentences1 = [ex.texts[0] for ex in val_data]\\n\",\n        \"sentences2 = [ex.texts[1] for ex in val_data]\\n\",\n        \"scores = [ex.label for ex in val_data]\\n\",\n        \"evaluator = evaluation.EmbeddingSimilarityEvaluator(sentences1, sentences2, scores)\\n\",\n        \"\\n\",\n        \"num_epochs = 4\\n\",\n        \"warmup_steps = math.ceil(len(train_dataloader) * num_epochs * 0.1)\\n\",\n        \"\\n\",\n        \"logging.info(f\\\"Starting Training: {num_epochs} Epochs, {len(train_data)} Pairs.\\\")\\n\",\n        \"\\n\",\n        \"model.fit(\\n\",\n        \"    train_objectives=[(train_dataloader, train_loss)],\\n\",\n        \"    evaluator=evaluator,\\n\",\n        \"    epochs=num_epochs,\\n\",\n        \"    evaluation_steps=500,\\n\",\n        \"    warmup_steps=warmup_steps,\\n\",\n        \"    output_path=model_save_path\\n\",\n        \")\\n\",\n        \"\\n\",\n        \"logging.info(f\\\"✅ Training Complete. Model saved to {model_save_path}\\\")\"\n      ],\n      \"metadata\": {\n        \"colab\": {\n          \"base_uri\": \"https://localhost:8080/\",\n          \"height\": 1000,\n          \"referenced_widgets\": [\n            \"756f701498f44ee895179926c6f94ecc\",\n            \"7420bac7b46c4d7b9a8f0bf0a8e010ae\",\n            \"5d4c084f44e84424b4219e55db0f1afe\",\n            \"bc8422bb7ac74db0a18326dd98cc4ca7\",\n            \"9c37996bffba4fdfbb7707954774308d\",\n            \"4a8ac65b82124307b15ebadc53bb4e79\",\n            \"92d99d5ee5264147a54883ba69c106d6\",\n            \"175095c488544e5c9e16878297d03e20\",\n            \"ed719f2425c841f281314defdb2b65e0\",\n            \"ccfe34ca076148ae98ddd44fa1b32e85\",\n            \"56f0af08d59646199b18cf82922da593\",\n            \"9310ff40746741e3b531020ee4f81a10\",\n            \"9d795f1fb8184d7eaffc67519764eeff\",\n            \"ef9eaf311b134a3cb9768d75f9ca7a8c\",\n            \"629a3f22c17b43c8a035ee0d16b93a12\",\n            \"bc7f5b9d9d4245fca45729f1187d5fe0\",\n            \"c872bc9951ef40b2b52ac9329ca88d87\",\n            \"8aa77c2dfcdc46aa9a36deec0fa80241\",\n            \"1aca96faa67a46b89d09724dc18e3edd\",\n            \"03813168454d47cabd75dd3ed9199717\",\n            \"210b52c61c354fc79486c5de100af41b\",\n            \"8a3b4fb809504990999b8f71677834fe\",\n            \"0213dba105de4c0abf67223bc6ad61da\",\n            \"ab264ee601974bb687eaac4148f8fd02\",\n            \"4f1894edcd1e4146b2198d8613c43738\",\n            \"7a185405df1547adb1cc5969ba3e345b\",\n            \"ff99ac6286a74448ac41f784e6b2fc8a\",\n            \"17766508852640a48bd7c2061ef4ff9b\",\n            \"fd3ecd9e11714c2eba1e8d408204f99c\",\n            \"0355074a12244f22b9d0608a84df178f\",\n            \"965929a2d5ad414abbb1b6e3588cdad4\",\n            \"de83eca340ac4837a18ffe06510f9207\",\n            \"cd4c9a45f4374ab3b5177c445789191a\",\n         